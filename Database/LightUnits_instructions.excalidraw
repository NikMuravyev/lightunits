    {
      "id": "i-s65xfWc6On8LRizOkI3",
      "type": "text",
      "x": 40.024364865747486,
      "y": -2903.2393370121417,
      "width": 699.375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
