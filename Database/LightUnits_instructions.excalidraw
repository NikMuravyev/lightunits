      "seed": 734019104,
      "version": 896,
      "versionNonce": 891621391,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781015059426,
      "link": null,
      "locked": false,
      "text": "РОЛИ - ГЛАГОЛЬНЫЕ\nАгенс (переходный активный субъект): Xrole: Agt\nПациенс (переходный объект, меняющий состояние, например при глаголах\nгреть, бить или ломать): Xrole: Pat\nТема  (переходный объект, НЕ меняющий состояние, например при глаголах\nчитать, нести или держать): Xrole: Th\nЭкспериенцер (переходный субъект при глаголах восприятия и эмоций видеть,\nслышать, чувствовать, радоваться): Xrole: Exp\nСтимул (переходный объект при глаголах восприятия и эмоций): Xrole: Exp",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e83Dj2JdElOwc7nhau2Yg",
      "originalText": "РОЛИ - ГЛАГОЛЬНЫЕ\nАгенс (переходный активный субъект): Xrole: Agt\nПациенс (переходный объект, меняющий состояние, например при глаголах греть, бить или ломать): Xrole: Pat\nТема  (переходный объект, НЕ меняющий состояние, например при глаголах читать, нести или держать): Xrole: Th\nЭкспериенцер (переходный субъект при глаголах восприятия и эмоций видеть, слышать, чувствовать, радоваться): Xrole: Exp\nСтимул (переходный объект при глаголах восприятия и эмоций): Xrole: Exp",
      "autoResize": true,
      "lineHeight": 1.25
    },
